<Window x:Class="MoMakan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoMakan — Katalog Kuliner Murah Mahasiswa ITS" Width="1280" Height="800" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource BodyFont}" FontSize="14"
        Background="{DynamicResource BgBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseMenuCommand}"/></Window.InputBindings>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource SidebarBrush}" Padding="14,22">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="🍨 MoMakan" FontFamily="{StaticResource HeadFont}" FontSize="21" FontWeight="Bold" Margin="8,0,0,2"/>
                        <TextBlock Text="Makan murah, dompet aman." Style="{StaticResource Muted}" Margin="10,0,0,22"/>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="navBtn" Style="{StaticResource NavButton}" Command="{Binding DataContext.NavCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Width="28"/>
                                            <TextBlock Text="{Binding Title}"/>
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="navBtn" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            <Setter TargetName="navBtn" Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="{Binding ThemeGlyph}" Style="{StaticResource NavButton}" Command="{Binding ThemeCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Konten -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- Bilah atas: pencarian + profil (untuk tamu, pengguna, dan admin) -->
                <Grid Margin="32,18,32,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Memuat…" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               Visibility="{Binding Current.IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Cari tempat makan atau menu" ToolTip="Cari nama tempat atau menu">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Cari" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                        <Button Style="{StaticResource ProfileButton}" Margin="14,0,0,0" Command="{Binding ToggleMenuCommand}"
                                AutomationProperties.Name="Menu profil" ToolTip="Profil">
                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding Current}" IsTabStop="False"/>
            </Grid>
        </Grid>

        <!-- Menu profil: lapisan transparan menutup menu saat klik di luar -->
        <Button Focusable="False" Visibility="{Binding MenuOpen, Converter={StaticResource BoolToVis}}" Command="{Binding CloseMenuCommand}" Cursor="Arrow">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
        </Button>
        <Border Style="{StaticResource Card}" Width="270" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,32,0"
                Visibility="{Binding MenuOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding ProfileRole}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource InvBoolToVis}}">
                    <Button Content="Masuk" Style="{StaticResource PrimaryButton}" Command="{Binding PromptLoginCommand}"/>
                    <Button Content="Daftar" Margin="0,8,0,0" Command="{Binding PromptRegisterCommand}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                    <Button Content="⚙  Profil &amp; Pengaturan" Command="{Binding SettingsCommand}" HorizontalContentAlignment="Left"/>
                    <Button Content="↩  Keluar" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Command="{Binding LogoutCommand}" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toast -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="22,12" CornerRadius="14"
                Visibility="{Binding ToastShow, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource CardGreen}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastError}" Value="True"><Setter Property="Background" Value="{StaticResource CardRed}"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource DarkInk}" FontWeight="SemiBold" MaxWidth="640" TextWrapping="Wrap"/>
        </Border>

        <!-- Dialog ajakan login/registrasi untuk tamu -->
        <Grid Background="{DynamicResource OverlayBrush}" Visibility="{Binding PromptOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="400" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Login dulu, yuk!" Style="{StaticResource Heading}" FontSize="22"/>
                    <TextBlock Text="Untuk menulis ulasan, menyimpan favorit, atau mengajukan tempat baru, kamu perlu masuk atau mendaftar." Style="{StaticResource Muted}" Margin="0,8,0,20"/>
                    <Button Content="Masuk" Style="{StaticResource PrimaryButton}" Command="{Binding PromptLoginCommand}"/>
                    <Button Content="Daftar" Margin="0,8,0,0" Command="{Binding PromptRegisterCommand}"/>
                    <Button Content="Nanti saja" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Command="{Binding PromptCloseCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
